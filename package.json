{
  "name": "sleeppilot",
  "version": "2.7.0",
  "description": "Autonomous engineering harness with OpenCode, Claude Code, Codex, OpenAI-compatible APIs, DeepSeek Harness and custom CLIs; Scout toolchain detection, evidence-based verification, a project workspace, live web preview, Android APK builds, multi-project runs, GitHub publishing, office document tools (Excel, CSV, Word, PowerPoint, PDF, charts) and Sleep & Reverse & Rust It.",
  "license": "MIT",
  "author": "akadirsanli",
  "type": "module",
  "main": "src/main.mjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akadirsanli/SleepPilot.git"
  },
  "homepage": "https://github.com/akadirsanli/SleepPilot#readme",
  "bugs": {
    "url": "https://github.com/akadirsanli/SleepPilot/issues"
  },
  "bin": {
    "sleeppilot": "src/main.mjs"
  },
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "prestart": "node scripts/ensure-deps.mjs",
    "start": "node src/main.mjs",
    "start:test-mode": "node src/main.mjs --test-mode",
    "test": "node test/run.mjs",
    "test:real": "node test/run.mjs real",
    "doctor": "node src/main.mjs doctor",
    "engines": "node src/main.mjs engines --connect",
    "office": "node src/main.mjs office"
  },
  "keywords": [
    "autonomous-agent",
    "agent-orchestrator",
    "opencode",
    "claude-code",
    "codex-cli",
    "deepseek",
    "openai-compatible",
    "ollama",
    "deepseek-harness",
    "toolchain-detection",
    "reverse-engineering",
    "rust",
    "android",
    "apk",
    "live-preview",
    "github",
    "overnight",
    "windows",
    "excel",
    "xlsx",
    "pdf",
    "docx",
    "office"
  ],
  "files": [
    "src/",
    "ui/",
    "scripts/",
    "docs/",
    "SleepPilot.cmd",
    "sleeppilot.sh",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY.md"
  ],
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "docx": "^9.16.0",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "papaparse": "^5.7.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pdfmake": "^0.3.15",
    "pngjs": "^7.0.0",
    "pptxgenjs": "^4.0.1"
  },
  "overrides": {
    "image-size": "^2.0.3",
    "uuid": "^11.1.1"
  }
}
